# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# yerel sırlar ve medya
/.local
/storage
/.next-e2e

# production derleme çıktısı ve sunucu dosyaları
/.build
/.env.production
/deploy/snapshots
/backups

# ── Sır ve üretim verisi GitHub'a GİTMEZ ──
