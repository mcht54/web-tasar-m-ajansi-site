!deploy/.env.production.example
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ecdsa*
id_ed25519*
*_ed25519
*_ed25519.pub
*service-account*.json
*credentials*.json
client_secret*.json
# veritabanı yedekleri ve verisi
backups/
*.dump
*.sql.gz
*.bak
pgdata/
postgres-data/
postgres_data/
