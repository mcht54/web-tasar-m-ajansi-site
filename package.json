{
  "name": "mchttasarim-webtasarimajansi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "job": "tsx --conditions=react-server scripts/job.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:db": "dotenv -e .env -v DATABASE_URL=$TEST_DATABASE_URL -- prisma migrate reset --force --skip-seed",
    "test:e2e": "bash scripts/e2e.sh",
    "seo:validate": "node scripts/seo-validate.mjs",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "marked": "^18.0.14",
    "next": "16.3.6",
    "node-html-parser": "^9.0.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
