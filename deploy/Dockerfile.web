# Web imajı: derleme, veritabanına bağlı "builder" konteynerinde yapılır (ana sayfa ve
# sitemap derlemede önceden oluşturulur) ve çıktı .build/ klasöründen kopyalanır.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3300 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
RUN useradd -r -u 1001 app && mkdir -p /app/storage/media
COPY .build/standalone ./
COPY .build/static ./.next/static
COPY public ./public
# ISR/önbellek yazımı için uygulama kullanıcısı .next ve storage'a yazabilmeli
RUN mkdir -p /app/.next/cache && chown -R app:app /app/.next /app/storage
USER app
EXPOSE 3300
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD node -e "fetch('http://127.0.0.1:3300/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
