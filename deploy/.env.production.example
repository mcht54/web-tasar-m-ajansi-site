# /opt/mcht/webtasarimajansi/.env — YALNIZCA bu projeye ait. Git'e eklenmez (chmod 600).
# deploy.sh ilk çalıştırmada eksik sırları otomatik üretir.
SITE_URL=https://webtasarimajansi.net
WEB_PORT=3400                      # yalnızca 127.0.0.1'e açılır (host Nginx için)
POSTGRES_USER=webtasarimajansi
POSTGRES_DB=webtasarimajansi
POSTGRES_PASSWORD=                 # otomatik üretilir
APP_SECRET=                        # otomatik üretilir (sır şifreleme anahtarı; değiştirilirse kayıtlı sırlar okunamaz)
EMAIL_TRANSPORT=smtp               # SMTP ayarları panelden (Ayarlar → Bildirimler)
# İlk kurulumda yönetici (yalnızca veritabanı boşsa kullanılır)
SEED_ADMIN_EMAIL=                  # yönetici e-postası (sunucuda girilir)
SEED_ADMIN_USERNAME=               # yönetici kullanıcı adı (sunucuda girilir)
SEED_ADMIN_PASSWORD=               # dağıtımda girilir; kaynak koda yazılmaz
