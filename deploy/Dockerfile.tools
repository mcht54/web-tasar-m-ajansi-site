# Araç imajı: kaynak + tüm bağımlılıklar. Kullanım: migration/seed, üretim derlemesi
# (builder), SEO ajanı worker ve scheduler konteynerleri.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/* \
  && useradd -r -u 1001 -m app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Worker önceden tek dosyaya derlenir: çalışırken npm/tsx/esbuild süreçleri ve TypeScript
# dönüştürücüsü bellekte tutulmaz (tsx yalnızca elle çalıştırılan ops betikleri için kalır).
RUN npx prisma generate && npm run build:worker && chown -R app:app /app
USER app
CMD ["node", "--conditions=react-server", "dist/worker.mjs"]
